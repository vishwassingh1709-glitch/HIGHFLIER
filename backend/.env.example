# ---------------------------------------------------------------------------
# HIGHFLIER backend environment configuration
# Copy this file to .env and replace every placeholder.
# NEVER commit .env or real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

# MongoDB (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/highflier
# MONGODB_DB_NAME=highflier
# Optional development DNS resolvers (comma-separated IP addresses; leave unset to use system DNS).
# Example: DNS_SERVERS=8.8.8.8,8.8.4.4
DNS_SERVERS=

# JWT (generate two different secrets, each 64+ random characters)
JWT_ACCESS_SECRET=replace-with-a-64-character-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Supplies AES-256-GCM encryption for supplier API credentials.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# CORS allowlist (comma separated); localhost:5000 is also allowed automatically in development only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
PAYMENT_RATE_LIMIT_MAX=30

# Admin seeding (used by: npm run seed:admin)
ADMIN_NAME=HIGHFLIER Admin
ADMIN_EMAIL=admin@highflier.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Account security
REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Razorpay (test keys first: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Clearly labelled local mock gateway. NEVER enable in production.
PAYMENTS_MOCK_MODE=false
PAYMENT_MOCK_SECRET=

# Cloudinary (optional; admin image uploads are rejected with 503 when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=highflier

# SMTP (optional; links are only previewed in logs in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HIGHFLIER <no-reply@highflier.local>

# Supplier integrations
# Comma separated approved HTTPS hosts. Required before a live supplier can be added.
SUPPLIER_ALLOWED_HOSTS=
SUPPLIER_HTTP_TIMEOUT_MS=15000
AUTO_ACTIVATE_IMPORTED_PRODUCTS=false
STALE_INVENTORY_HOURS=24

# Commerce rules (INR)
SHIPPING_FEE_INR=49
FREE_SHIPPING_THRESHOLD_INR=999
COD_FEE_INR=0
TAX_PERCENT=0
ORDER_RESERVATION_TTL_MINUTES=15
RETURN_WINDOW_DAYS=7
MAX_PAGE_SIZE=100

# Scheduled jobs
JOBS_ENABLED=true
CATALOGUE_SYNC_CRON=0 * * * *
INVENTORY_SYNC_CRON=*/15 * * * *
SUPPLIER_ORDER_RETRY_CRON=*/5 * * * *
SUPPLIER_STATUS_SYNC_CRON=*/10 * * * *
RESERVATION_EXPIRY_CRON=* * * * *
